rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication requirement: require authenticated requests (including anonymous auth).
    // Note: Role-based rules (admin vs worker) require custom claims set via a Cloud Function,
    // which is a follow-up beyond this task's scope.
    
    match /workers/{workerId} {
      allow read, write: if request.auth != null;
    }

    match /attendance_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /work_sites/{siteId} {
      allow read, write: if request.auth != null;
    }

    match /system_config/{configId} {
      allow read, write: if request.auth != null;
    }

    match /leave_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /leave_balances/{balanceId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /device_security_alerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    // Fallback rule for any other subcollections or nested paths
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
